# Copy to .env at the repo root (codelab convention). Scripts and tools.yaml read it.
# The ADK agent reads tms_agent/.env (see tms_agent/.env.example).

# Google Cloud project configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global        # Gemini calls (Vertex AI global endpoint)
REGION=us-central1                  # AlloyDB, Cloud Run, Agent Engine and other infrastructure

# AlloyDB (only if you use the AlloyDB backend or the MCP Toolbox AlloyDB source)
ALLOYDB_PASSWORD=your-password

# MCP Toolbox for Databases (optional, serves tools.yaml)
TOOLBOX_URL=http://127.0.0.1:5000

# Trimble PC*MILER Web Services (optional; without it re-routed miles are labelled estimates)
# PCMILER_API_KEY=
