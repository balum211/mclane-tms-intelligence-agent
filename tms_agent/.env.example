# Copy to tms_agent/.env (adk web / adk run / adk deploy read this file).

# --- Gemini via Vertex AI (Gemini Enterprise / Google Cloud) ---
# ADK 2.x reads GOOGLE_GENAI_USE_ENTERPRISE; older ADK / the codelab starter read GOOGLE_GENAI_USE_VERTEXAI.
GOOGLE_GENAI_USE_ENTERPRISE=True
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# --- or Gemini API key for a quick local test (set both flags above to False) ---
# GOOGLE_API_KEY=...

# Models (any Gemini model enabled in your project)
TMS_MODEL=gemini-3.5-flash
# TMS_SQL_MODEL=gemini-3.8-flash
# TMS_DOC_MODEL=gemini-3.5-flash

# --- Data backend: duckdb (local demo) | bigquery | alloydb ---
TMS_DB_BACKEND=duckdb
# TMS_DUCKDB_PATH=data/tms.duckdb

# BigQuery
# TMS_BQ_PROJECT=your-project-id
# TMS_BQ_DATASET=mclane_tms
# TMS_BQ_LOCATION=US

# AlloyDB (via AlloyDB Auth Proxy on localhost, or private IP)
# TMS_ALLOYDB_DSN=postgresql://tms_reader:PASSWORD@127.0.0.1:5432/postgres
# TMS_ALLOYDB_SCHEMA=tms

# --- McLane operational signals ---
# PCMILER_API_KEY=                      # Trimble PC*MILER Web Services; unset = labelled estimate
# PCMILER_EXTRA_PARAMS=                 # account-specific route options, e.g. routing type
# TMS_TRUCK_HOUR_COST_USD=85            # $ per truck hour for dwell change impact
# TMS_OOR_FLAG_PCT=0.08                 # out-of-route flag threshold

# --- Guardrails for auto-tender ---
TMS_AUTO_TENDER_MAX_USD=2500
TMS_AUTO_TENDER_MIN_CONFIDENCE=0.80

# --- Decision audit log sinks (JSONL file + Cloud Logging always; these are optional) ---
# TMS_DECISION_LOG_PATH=data/decision_log.jsonl
# TMS_DECISION_LOG_BQ_TABLE=your-project-id.mclane_tms.agent_decision_log
# TMS_DECISION_LOG_ALLOYDB_DSN=postgresql://tms_writer:PASSWORD@127.0.0.1:5432/postgres
